# Local Vite overrides — copy to web/.env.local (gitignored).
# Repo-root .env is not loaded when the Vite project root is web/.

# Optional: same-hub JSON diagnostic transport (MessagePack remains the default).
# VITE_AGENTCORE_REALTIME_PROTOCOL=json

# Restart `pnpm dev` after changing; a browser refresh alone does not re-read env.
