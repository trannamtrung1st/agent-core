<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>agent-core-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentCore.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Session workspace/artifact trees under data/ are runtime content, not host source. -->
    <Compile Remove="data/**" />
    <Content Remove="data/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentCore.Application\AgentCore.Application.csproj" />
    <ProjectReference Include="..\AgentCore.Infrastructure\AgentCore.Infrastructure.csproj" />
    <ProjectReference Include="..\AgentCore.Contracts\AgentCore.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.12" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>

</Project>
