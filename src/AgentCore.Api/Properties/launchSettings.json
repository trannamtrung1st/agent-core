{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://127.0.0.1:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "AgentCore__Profile": "Synthetic",
        "Security__Http__AllowInsecureLocalHttp": "true",
        "Security__Http__AllowedOrigins__0": "http://localhost:5173",
        "Security__Http__AllowedOrigins__1": "http://127.0.0.1:5173"
      }
    },
    "http-real": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://127.0.0.1:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "AgentCore__Profile": "Real",
        "Security__Http__AllowInsecureLocalHttp": "true",
        "Security__Http__AllowedOrigins__0": "http://localhost:5173",
        "Security__Http__AllowedOrigins__1": "http://127.0.0.1:5173",
        "Persistence__Provider": "Sqlite",
        "Persistence__ConnectionString": "Data Source=data/agent-core.db",
        "Browser__PolicyMode": "OpenWeb",
        "Browser__ProfileMode": "PersistentAgent",
        "Browser__ProfileRoot": "../../local/browser-profiles",
        "Browser__Channel": "chrome",
        "Browser__FixtureEnabled": "false",
        "Browser__Headless": "false",
        "Browser__InteractionMode": "InteractiveDemo"
      }
    }
  }
}
