{
  "AgentCore": {
    "Profile": "Synthetic",
    "AgentDirectory": "agents",
    "MaxActiveSessions": 10,
    "MaxEntriesPerSession": 1000
  },
  "GoogleOAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "PublicAppUrl": ""
  },
  "GoogleDrive": {
    "Enabled": true
  },
  "OpenSandbox": {
    "Enabled": true,
    "Endpoint": "http://127.0.0.1:18080"
  },
  "Email": {
    "Enabled": true,
    "SmtpEnabled": true
  },
  "Interaction": {
    "PendingVoiceTimeoutMs": 30000
  },
  "Persistence": {
    "Provider": "InMemory",
    "ConnectionString": "Data Source=data/agent-core.db",
    "CheckpointMs": 1000,
    "BusyTimeoutMs": 5000,
    "AttachmentRoot": "data/attachments",
    "WorkspaceRoot": "data/workspaces",
    "TemplateRoot": "agents/templates",
    "ArtifactRoot": "data/artifacts"
  },
  "Providers": {
    "Speech": {
      "Recognition": {
        "Adapter": "Synthetic"
      },
      "Synthesis": {
        "Adapter": "Synthetic"
      }
    }
  },
  "Browser": {
    "Enabled": true,
    "Headless": false,
    "InteractionMode": "InteractiveDemo",
    "PolicyMode": "Restricted",
    "ProfileMode": "EphemeralSession",
    "ProfileRoot": "data/browser-profiles",
    "FixtureEnabled": true,
    "FixturePort": 5091,
    "NavigationOrigins": [
      "http://127.0.0.1:5091"
    ],
    "InteractionOrigins": [
      "http://127.0.0.1:5091"
    ],
    "ResourceOrigins": []
  },
  "Hosting": {
    "BindUrl": "http://127.0.0.1:5080",
    "AllowedOrigins": [
      "http://127.0.0.1:5173"
    ],
    "UseViteProxy": true
  },
  "Observability": {
    "HttpErrorResponses": {
      "Enabled": true
    },
    "LogLevel": "Information",
    "TimelineCapacity": 64,
    "LogConversationContent": false,
    "OtlpEnabled": false,
    "OtlpEndpoint": "http://127.0.0.1:4318"
  },
  "Logging": {
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "UseUtcTimestamp": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FilePreview": {
    "Limits": {
      "MaxBytes": 33554432,
      "TextBytes": 2097152,
      "DelimitedBytes": 5242880,
      "DocxBytes": 10485760,
      "XlsxBytes": 10485760,
      "ImageBytes": 15728640,
      "AudioBytes": 33554432,
      "VideoBytes": 33554432
    },
    "Text": {
      "MaxLines": 10000,
      "HighlightMaxBytes": 262144,
      "HighlightMaxLines": 3000
    },
    "Image": {
      "MaxPixels": 40000000,
      "MaxDimension": 32768
    },
    "Spreadsheet": {
      "RowsPerWindow": 200,
      "ColumnsPerWindow": 64,
      "MaxCellsPerWindow": 12800,
      "CsvMaxParsedRows": 50000,
      "CsvMaxParsedColumns": 256,
      "MaxCellCharacters": 4096,
      "MaxWindowCharacters": 64000
    },
    "WorkerTimeoutMs": 5000
  }
}
