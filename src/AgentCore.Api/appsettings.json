{
  "AgentCore": {
    "Profile": "Synthetic",
    "AgentDirectory": "agents",
    "MaxActiveSessions": 10,
    "MaxEntriesPerSession": 1000
  },
  "Interaction": {
    "PendingVoiceTimeoutMs": 30000
  },
  "Persistence": {
    "Provider": "InMemory",
    "ConnectionString": "Data Source=data/agent-core.db",
    "CheckpointMs": 1000,
    "BusyTimeoutMs": 5000,
    "AttachmentRoot": "data/attachments",
    "WorkspaceRoot": "data/workspaces",
    "TemplateRoot": "agents/templates",
    "ArtifactRoot": "data/artifacts"
  },
  "Providers": {
    "LanguageModels": {
      "primary-llm": {
        "Adapter": "Scripted"
      }
    },
    "ModelCatalog": {
      "DefaultKey": "scripted-alpha",
      "Models": [
        {
          "Key": "scripted-alpha",
          "DisplayName": "Scripted Alpha",
          "ProviderAlias": "primary-llm",
          "ModelId": "scripted-alpha",
          "Tools": true,
          "Vision": false,
          "StructuredOutput": false,
          "Reasoning": true,
          "SupportedReasoningEfforts": [ "low", "medium", "high" ],
          "DefaultReasoningEffort": "medium"
        },
        {
          "Key": "scripted-beta",
          "DisplayName": "Scripted Beta",
          "ProviderAlias": "primary-llm",
          "ModelId": "scripted-beta",
          "Tools": true,
          "Vision": false,
          "StructuredOutput": true,
          "Reasoning": false,
          "SupportedReasoningEfforts": []
        }
      ]
    },
    "Speech": {
      "Recognition": {
        "Adapter": "Synthetic"
      },
      "Synthesis": {
        "Adapter": "Synthetic"
      }
    }
  },
  "Hosting": {
    "BindUrl": "http://127.0.0.1:5080",
    "AllowedOrigins": [ "http://127.0.0.1:5173" ],
    "UseViteProxy": true
  },
  "Observability": {
    "LogLevel": "Information",
    "TimelineCapacity": 64,
    "LogConversationContent": false,
    "OtlpEnabled": false,
    "OtlpEndpoint": "http://127.0.0.1:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
