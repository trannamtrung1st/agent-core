# Agent Core startup preset. Advanced options: docs/host-configuration-reference.md.
# Copy to .env once; dev-real.sh automatically parses/exports it for every command.
# No dotnet user-secrets or manual `source .env` is required.
#
# Fill the five AGENTCORE_BOOTSTRAP_* values for fresh setup:
#   scripts/dev-real.sh bootstrap-identity
#   scripts/dev-real.sh start              # native API/Vite + managed Sandbox
#   scripts/dev-real.sh start --api-only   # native API/Vite without managed Docker
#
# .env is private and gitignored. Never put a secret in a VITE_* value.
# The native loader treats values literally: no shell commands or ${VAR} expansion.
# Single/double quotes protect spaces, # and $.
# This is a dotenv file, NOT a shell script; do not source it in a shell.
# Native precedence: profile defaults < inherited environment < selected .env.
# Paths below are relative to the repository; explicit SQLite connection strings
# are passed literally (use an absolute Data Source when overriding the derived one).
# Managed Sandbox connection/workspace handoff, --api-only disable, loopback bind
# and the native HTTP/origin exception remain launcher-owned after file loading.
#
# .NET options use PascalCase__Segments; launcher/Compose inputs use UPPER_SNAKE_CASE.
# GOOGLE_OAUTH_* inputs translate once at the launcher/Compose boundary. Pure
# dotnet hosts use GoogleOAuth__ClientId/__ClientSecret/__PublicAppUrl instead.
# Never set both spellings for the same option. Deploy with python3 scripts/compose.py.

# Native launcher, storage and public Vite settings
AGENTCORE_DEV_STATE_DIR=local/dev
AGENTCORE_DEV_API_DATA_DIR=data/native
AGENTCORE_DEV_API_PORT=5080
AGENTCORE_DEV_WEB_PORT=5173
AGENTCORE_SANDBOX_PROJECT=agent-core-sandbox
AGENTCORE_SANDBOX_PORT=18080
# Select another file from the calling environment: AGENTCORE_DEV_ENV_FILE=/absolute/file.env
# Vite proxy/port are derived from the native ports; these remain public options:
VITE_AGENTCORE_REALTIME_PROTOCOL=messagepack
# VITE_DEV_PORT=5173                  # derived by dev-real.sh
# VITE_API_PROXY_TARGET=http://127.0.0.1:5080  # derived by dev-real.sh
# VITE_CACHE_DIR=/absolute/private-cache
# VITE_PREVIEW_PORT=4173

# Model inference credentials are protected tenant-owned records created after IAM bootstrap.
# Configure AI models: credential → connection → metadata test → adopt models → explicit default.
# Independent backend speech/search/OAuth keys (empty means no credential is provided)
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PUBLIC_APP_URL=

# Explicit one-use account initialization, after a reset/new SQLite database.
# Set all five; password length is 12..256. No automatic account is created.
AGENTCORE_BOOTSTRAP_LOGIN=
AGENTCORE_BOOTSTRAP_DISPLAY_NAME=
AGENTCORE_BOOTSTRAP_PASSWORD=
AGENTCORE_BOOTSTRAP_TENANT_NAME=
AGENTCORE_BOOTSTRAP_TENANT_SLUG=

# Native Real profile. Every value can be edited without launch-profile overrides.
ASPNETCORE_ENVIRONMENT=Development
AgentCore__Profile=Real
Persistence__Provider=Sqlite
Browser__PolicyMode=OpenWeb
Browser__ProfileMode=PersistentAgent
Browser__ProfileRoot=data/native/browser-profiles
Browser__Channel=chrome
Browser__FixtureEnabled=false
Browser__Headless=false
Browser__InteractionMode=InteractiveDemo
AgentCore__AgentDirectory=agents
Email__Enabled=true
Email__SmtpEnabled=true

# Compose-only/deployment interpolation. Secrets remain blank by default.
# HTTPS overlay requires a private readable PFX and its operator-supplied password.
AGENTCORE_TLS_CERTIFICATE_PATH=
AGENTCORE_TLS_PASSWORD=
# AGENTCORE_COMPOSE_PORT=5080
# COMPOSE_PROJECT_NAME=agent-core
# AGENTCORE_DRIVE_ENABLED=true
# AGENTCORE_EMAIL_SMTP_ENABLED=true
# AGENTCORE_EMAIL_SEND_ENABLED=true

# Optional nopCommerce demo (separate data/project; not reset with Core).
# Its SQL password cannot contain quotes, $, CR or LF. Admin blank generates once.
NOPCOMMERCE_DB_PASSWORD=
NOPCOMMERCE_ADMIN_PASSWORD=
NOPCOMMERCE_ADMIN_EMAIL=demo-owner@example.com
# AGENTCORE_WEBHOOK_URL=http://host.docker.internal:5080/api/v1/hooks/EXACT_EVENT_KEY
# AGENTCORE_WEBHOOK_TOKEN=
# NOPCOMMERCE_ORIGIN=http://127.0.0.1:5088

# Optional host-operated decision inference. Disabled and shadowed by default.
# Never register Kev as a tenant model. KEV_API_KEY belongs to the external process;
# the private host DecisionIntelligence__ApiKey must match it for native serving.
DecisionIntelligence__Enabled=false
DecisionIntelligence__Backend=LocalKev
DecisionIntelligence__Endpoint=http://127.0.0.1:8009
DecisionIntelligence__ModelId=jaredpalmer/kev-4b@6cfce5c2fa4b4bd64026336ab649c5ca78857d52
DecisionIntelligence__RequestTimeoutMs=500
DecisionIntelligence__MaxConcurrentRequests=4
DecisionIntelligence__MaxStateCharacters=8000
DecisionIntelligence__ShadowMode=true
# Private only: DecisionIntelligence__ApiKey=...
# Private only: KEV_API_KEY=...
