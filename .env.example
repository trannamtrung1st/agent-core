# Agent Core native development and Compose configuration reference.
# Copy to .env once; dev-real.sh automatically parses/exports it for every command.
# No dotnet user-secrets or manual `source .env` is required.
#
# Fill OPENROUTER_API_KEY and the five AGENTCORE_BOOTSTRAP_* values for fresh setup:
#   scripts/dev-real.sh bootstrap-identity
#   scripts/dev-real.sh start              # native API/Vite + managed Sandbox
#   scripts/dev-real.sh start --api-only   # native API/Vite without managed Docker
#
# .env is private and gitignored. Never put a secret in a VITE_* value.
# The native loader treats values literally: no shell commands or ${VAR} expansion.
# Single/double quotes protect spaces, # and $. Hyphenated .NET aliases work here.
# This is a dotenv file, NOT a shell script; do not source it in a shell.
# Native precedence: profile defaults < inherited environment < selected .env.
# Paths below are relative to the repository; explicit SQLite connection strings
# are passed literally (use an absolute Data Source when overriding the derived one).
# Managed Sandbox connection/workspace handoff, --api-only disable, loopback bind
# and the native HTTP/origin exception remain launcher-owned after file loading.
#
# Active values are the supported native Real preset, not a default account.
# The commented reference covers every bindable application option shape, explicit
# configuration lookup, indexed array/dictionary entry, and shipped logging field.
# N/ENTRY_NAME are templates: repeat indices/provider aliases/headers as needed.
# Derived/internal runtime values and delegate callbacks are not operator settings.
# Compose consumes its explicit AGENTCORE_*/GOOGLE_*/NOPCOMMERCE_* aliases below;
# it keeps container data paths. Arbitrary native .NET keys are not auto-forwarded.

# Native launcher, storage and public Vite settings
AGENTCORE_DEV_STATE_DIR=local/dev
AGENTCORE_DEV_API_DATA_DIR=data/native
AGENTCORE_DEV_API_PORT=5080
AGENTCORE_DEV_WEB_PORT=5173
AGENTCORE_SANDBOX_PROJECT=agent-core-sandbox
AGENTCORE_SANDBOX_PORT=18080
# Select another file from the calling environment: AGENTCORE_DEV_ENV_FILE=/absolute/file.env
# Vite proxy/port are derived from the native ports; these remain public options:
VITE_AGENTCORE_REALTIME_PROTOCOL=messagepack
# VITE_DEV_PORT=5173                  # derived by dev-real.sh
# VITE_API_PROXY_TARGET=http://127.0.0.1:5080  # derived by dev-real.sh
# VITE_CACHE_DIR=/absolute/private-cache
# VITE_PREVIEW_PORT=4173

# Backend-only keys (empty means no credential is provided)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PUBLIC_APP_URL=

# Explicit one-use account initialization, after a reset/new SQLite database.
# Set all five; password length is 12..256. No automatic account is created.
AGENTCORE_BOOTSTRAP_LOGIN=
AGENTCORE_BOOTSTRAP_DISPLAY_NAME=
AGENTCORE_BOOTSTRAP_PASSWORD=
AGENTCORE_BOOTSTRAP_TENANT_NAME=
AGENTCORE_BOOTSTRAP_TENANT_SLUG=

# Native Real profile. Every value can be edited without launch-profile overrides.
ASPNETCORE_ENVIRONMENT=Development
AgentCore__Profile=Real
Providers__LanguageModels__primary-llm__Adapter=OpenAICompatible
Providers__LanguageModels__primary-llm__BaseUrl=https://openrouter.ai/api/v1/
Providers__LanguageModels__primary-llm__DefaultModel=deepseek/deepseek-v4.1-flash
Providers__LanguageModels__primary-llm__ReasoningEffort=low
Providers__LanguageModels__primary-llm__ReasoningObjectWire=true
Providers__LanguageModels__primary-llm__ExcludeVisibleReasoning=true
Providers__LanguageModels__primary-llm__Vision=true
Providers__LanguageModels__primary-llm__Tools=true
Providers__LanguageModels__primary-llm__Timeouts__SetupSeconds=30
Providers__LanguageModels__primary-llm__Timeouts__StreamIdleSeconds=60
Providers__LanguageModels__primary-llm__Timeouts__TotalSeconds=120
Providers__ModelCatalog__DefaultKey=deepseek-v41-flash
Persistence__Provider=Sqlite
Browser__PolicyMode=OpenWeb
Browser__ProfileMode=PersistentAgent
Browser__ProfileRoot=data/native/browser-profiles
Browser__Channel=chrome
Browser__FixtureEnabled=false
Browser__Headless=false
Browser__InteractionMode=InteractiveDemo
AgentCore__AgentDirectory=agents
Email__Enabled=true
Email__SmtpEnabled=true

# Compose-only/deployment interpolation. Secrets remain blank by default.
# HTTPS overlay requires a private readable PFX and its operator-supplied password.
AGENTCORE_TLS_CERTIFICATE_PATH=
AGENTCORE_TLS_PASSWORD=
# AGENTCORE_COMPOSE_PORT=5080
# COMPOSE_PROJECT_NAME=agent-core
# AGENTCORE_LLM_MODEL=deepseek/deepseek-v4.1-flash
# AGENTCORE_LLM_REASONING_EFFORT=low
# AGENTCORE_LLM_VISION=true
# AGENTCORE_LLM_TOOLS=true
# AGENTCORE_DRIVE_ENABLED=true
# AGENTCORE_EMAIL_SMTP_ENABLED=true
# AGENTCORE_EMAIL_SEND_ENABLED=true

# Optional nopCommerce demo (separate data/project; not reset with Core).
# Its SQL password cannot contain quotes, $, CR or LF. Admin blank generates once.
NOPCOMMERCE_DB_PASSWORD=
NOPCOMMERCE_ADMIN_PASSWORD=
NOPCOMMERCE_ADMIN_EMAIL=demo-owner@example.com
# AGENTCORE_WEBHOOK_URL=http://host.docker.internal:5080/api/v1/hooks/EXACT_EVENT_KEY
# AGENTCORE_WEBHOOK_TOKEN=
# NOPCOMMERCE_ORIGIN=http://127.0.0.1:5088

# Legacy Google client aliases: migration/reconnection only, never refresh tokens.
# GOOGLE_EMAIL_OAUTH_CLIENT_ID=
# GOOGLE_EMAIL_OAUTH_CLIENT_SECRET=
# GOOGLE_EMAIL_OAUTH_PUBLIC_APP_URL=
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# GOOGLE_DRIVE_OAUTH_PUBLIC_APP_URL=

# General .NET host overrides (HTTP bind/origin policy is owned by dev-real.sh).
# DOTNET_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://127.0.0.1:5080
# ASPNETCORE_Kestrel__Certificates__Default__Path=/absolute/server.pfx
# ASPNETCORE_Kestrel__Certificates__Default__Password=

# Advanced application reference. Uncomment only the values you want to override.
# Array index 0 represents N; use successive indices. ENTRY_NAME is a map key.
# The current registered LLM alias is primary-llm. Model catalog entries must
# reference a registered alias; adding an arbitrary env alias does not register one.
# Speech has canonical nested and alternate primary-stt/primary-tts forms;
# configure one form, not conflicting duplicates. OPENAI_API_KEY is shared fallback.
# DeveloperRoleSupport=true requires a separately verified system/developer contract.
# InMemory requires the five Security__EphemeralBootstrap fields on every launch.
# Empty optional scalar values mean unset; supply actual values for array/map entries.

