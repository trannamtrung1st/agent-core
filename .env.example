# Gitignored local secrets for Compose interpolation and optional native export.
# Copy: cp .env.example .env
# Then fill secrets below as needed. Never commit .env.
#
# Real Compose (loads this file automatically from the repo root):
#   docker compose -f docker-compose.yml -f docker-compose.real.yml up --build
#
# Native (optional; .NET does not load .env by itself):
#   set -a && source .env && set +a
#   dotnet run --project src/AgentCore.Api --launch-profile http-openrouter
#
# AGENTCORE_LLM_MODEL selects the system default among catalog ModelIds.
# It does not rewrite the DeepSeek catalog entry. Do not set it to openrouter/free.

OPENROUTER_API_KEY=
AGENTCORE_LLM_MODEL=deepseek/deepseek-v4.1-flash
AGENTCORE_LLM_REASONING_EFFORT=low
AGENTCORE_LLM_VISION=true
AGENTCORE_LLM_TOOLS=true

# Optional Real-profile adapters (Synthetic profile ignores these; default tests stay key-free).
# Brave web.search when AgentCore__Profile=Real (Infrastructure also accepts BraveSearch:ApiKey).
BRAVE_SEARCH_API_KEY=

# Email accounts/passwords are managed through Admin, never host-global GMAIL_* fallback.
# SMTP dispatch is enabled by default; account binding and exact draft approval are still required.
# Compose reads AGENTCORE_EMAIL_SMTP_ENABLED; native .NET reads Email__SmtpEnabled.
AGENTCORE_EMAIL_SMTP_ENABLED=true
Email__SmtpEnabled=true

# nopCommerce demo only (scripts/nopcommerce-demo.sh). Synthetic CI does not read these.
# SQL Server sa password. Required before start/reset. Must satisfy SQL complexity rules
# and must not contain quotes, dollar signs, or line breaks.
NOPCOMMERCE_DB_PASSWORD=
# Leave blank to generate once into this file. The script prints a new password on the terminal.
NOPCOMMERCE_ADMIN_PASSWORD=
NOPCOMMERCE_ADMIN_EMAIL=demo-owner@example.com
# Optional. Injected into the nopCommerce container for the order.placed plugin.
# Leave blank until a shared Event exists. Its public Event key addresses the webhook; the secret authenticates it.
# AGENTCORE_WEBHOOK_URL=http://host.docker.internal:5080/api/v1/hooks/{eventKey}
# AGENTCORE_WEBHOOK_TOKEN=

# Vite / frontend only — optional JSON SignalR diagnostic mode (same /hubs/session hub; MessagePack stays default).
# For native Vite use web/.env.local, not the repo-root .env. Vite does not load this file.
# VITE_AGENTCORE_REALTIME_PROTOCOL=json
# Or: cd web && VITE_AGENTCORE_REALTIME_PROTOCOL=json pnpm dev
# Restart the Vite dev server after changing it; a browser refresh alone is not enough.
# Built Compose SPA: docker compose build --build-arg VITE_AGENTCORE_REALTIME_PROTOCOL=json && docker compose up

# Google OAuth deployment client (backend-only; no process-global refresh-token setting).
# Shared Google OAuth client for Gmail and Drive (native host and Compose consume these).
# Register BOTH integration callback URLs; connecting each account grants separate scopes/tokens.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PUBLIC_APP_URL=
# Drive is enabled by default. This explicit switch is consumed by native and Compose hosts.
AGENTCORE_DRIVE_ENABLED=true
# Migration only: retain old integration-specific client values until their saved grants are reconnected.
# GOOGLE_EMAIL_OAUTH_CLIENT_ID / _CLIENT_SECRET / _PUBLIC_APP_URL
# GOOGLE_DRIVE_OAUTH_CLIENT_ID / _CLIENT_SECRET / _PUBLIC_APP_URL

# Optional host disable (Compose / native):
# AGENTCORE_DRIVE_ENABLED=false
# Legacy native section switch, used only when AGENTCORE_DRIVE_ENABLED is unset:
# GoogleDrive__Enabled=false
# Optional provider-neutral dispatch override. If absent, inherits the SMTP switch in Real.
# AGENTCORE_EMAIL_SEND_ENABLED=false
# Email__SendEnabled=false
