{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--output-dir",
        ".playwright-mcp/cursor/output",
        "--user-data-dir",
        ".playwright-mcp/cursor/user-data",
        "--snapshot-mode",
        "full",
        "--save-session"
      ]
    }
  }
}
