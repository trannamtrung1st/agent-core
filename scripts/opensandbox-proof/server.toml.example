# Trusted single-user local demo; only the server mounts the Docker socket.
# Inject a random private key through OPENSANDBOX_SERVER_API_KEY.
# No known placeholder key is provided. Never acknowledge insecure/key-free startup.
[server]
host = "0.0.0.0"
port = 8080
max_sandbox_timeout_seconds = 86400

[proxy]
resolve_internal = true

[runtime]
type = "docker"
execd_image = "opensandbox/execd@sha256:cda2bc35409bbf57561599b316cafb899598f7dce671332e7ceda14eb1cfeded"

[docker]
network_mode = "bridge"
# Docker Desktop publishes on the workstation, where the VM bridge address is
# not bindable. Native Linux uses its inspected bridge gateway instead (runner).
host_ip = "host.docker.internal"
publish_host = "127.0.0.1"
drop_capabilities = ["ALL"]
no_new_privileges = true
pids_limit = 64
port_range_min = 40000
port_range_max = 60000
sandbox_binds = []

[storage]
allowed_host_paths = []

[store]
type = "sqlite"
path = "/var/lib/opensandbox/proof.db"

[egress]
image = "opensandbox/egress@sha256:bce2cc2e4dc3a3594678b91ac29efb0669fccebfdfc137727018d3b087fbb13a"
mode = "dns+nft"
disable_ipv6 = true
readiness_timeout_seconds = 30
