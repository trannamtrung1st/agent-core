# Trusted local Workbench. Heavy dependencies are built once, never installed by a Session script.
FROM node@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e AS node
FROM python@sha256:5f55cdf0c5d9dc1a415637a5ccc4a9e18663ad203673173b8cda8f8dcacef689
ARG AGENTCORE_RUNTIME_UID=1654
ARG AGENTCORE_RUNTIME_GID=1654
ARG DEBIAN_SNAPSHOT=20251001T000000Z
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/%s/ trixie main\n' "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends git curl jq zip unzip libreoffice-writer libreoffice-calc poppler-utils fonts-dejavu-core \
    && mkdir -p /usr/share/agent-core \
    && dpkg-query -W > /usr/share/agent-core/dpkg-manifest.txt \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install --global typescript@5.9.3 \
    && npm cache clean --force
COPY requirements.txt /usr/share/agent-core/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /usr/share/agent-core/requirements.txt \
    && pip inspect > /usr/share/agent-core/python-manifest.json \
    && groupadd --gid 1000 sandbox \
    && useradd --uid 1000 --gid 1000 --create-home sandbox \
    && mkdir -p /working /opt/opensandbox \
    && chown $AGENTCORE_RUNTIME_UID:$AGENTCORE_RUNTIME_GID /working /opt/opensandbox
ENV MPLBACKEND=Agg PYTHONDONTWRITEBYTECODE=1
COPY --from=node /usr/local/LICENSE /usr/share/agent-core/node-LICENSE
COPY inventory.py /usr/share/agent-core/inventory.py
# Match Core's declared workspace owner; the provider drops all capabilities.
# Images with a different default identity fail the mount readiness probe.
USER $AGENTCORE_RUNTIME_UID:$AGENTCORE_RUNTIME_GID
WORKDIR /working
